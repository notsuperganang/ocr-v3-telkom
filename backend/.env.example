# API Configuration
APP_NAME="Telkom Contract Data Extractor"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000

# File Upload Settings
MAX_FILE_SIZE=52428800  # 50MB in bytes
UPLOAD_DIR="uploads"
OUTPUT_DIR="output"

# Basic Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telkom_contracts

# Authentication Configuration (REQUIRED - change these in production)
AUTH_USERNAME=your_username
AUTH_PASSWORD=your_password
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production

# OCR Device Configuration
# Options: "cpu" | "gpu" | "gpu:0" | "gpu:1" (for multi-GPU)
# NOTE: GPU requires paddlepaddle-gpu instead of paddlepaddle
#   CPU install:  pip install paddlepaddle==3.0.0
#   GPU install:  pip install paddlepaddle-gpu==3.0.0 -i https://www.paddlepaddle.org.cn/packages/stable/cu126/
DEVICE=cpu

# OCR Pipeline Optimization
# Disable models not needed for flat PDF contract scans (improves speed)
USE_DOC_ORIENTATION_CLASSIFY=false
USE_DOC_UNWARPING=false
USE_TEXTLINE_ORIENTATION=false

# NOTE: All other PP-StructureV3 pipeline configuration is centralized in app/config.py
